generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AGENT
  READER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// How widely a public ticket is visible. DEPARTMENT means exactly one
/// department (departmentId required); COMPANY_WIDE means everyone
/// (departmentId must be null). A DB CHECK constraint enforces the pairing so
/// `departmentId = null` can never be an ambiguous "unknown".
enum TicketVisibility {
  DEPARTMENT
  COMPANY_WIDE
}

/// A department owns public tickets and has members. "Teljes cég" is NOT a row
/// here — it is the COMPANY_WIDE visibility value, so it can't be renamed,
/// deleted or assigned to users.
model Department {
  id   String @id @default(cuid())
  name String @unique
  /// Lowercased `name`, written by the application (lib/departments.ts) and
  /// uniquely indexed, so "Logisztika" and "logisztika" can't coexist. A
  /// stored column rather than a LOWER(name) index because LOWER() only folds
  /// non-ASCII (é/É) under a UTF-8 aware DB collation — this stays correct
  /// regardless of how the database was initialised.
  nameNormalized String @unique
  color          String @default("#6C5CE7")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members    UserDepartment[]
  tickets    Ticket[]
  categories Category[]
}

/// Many-to-many join between users and departments.
model UserDepartment {
  id           String     @id @default(cuid())
  userId       String
  departmentId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, departmentId])
  @@index([departmentId])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  lastName     String?
  firstName    String?
  nickname     String?
  passwordHash String?
  role         Role       @default(AGENT)
  avatarUrl    String?
  status       UserStatus @default(INVITED)
  lastSeenAt   DateTime?
  createdAt    DateTime   @default(now())

  ticketsCreated  Ticket[]          @relation("CreatedBy")
  ticketsAssigned Ticket[]          @relation("AssignedTo")
  ticketCollaborations TicketCollaborator[] @relation("TicketCollaborator")
  collaboratorsAdded   TicketCollaborator[] @relation("TicketCollaboratorAddedBy")
  comments        Comment[]
  activities      ActivityLog[]
  notifications   NotificationLog[]
  savedReplies    SavedReply[]
  auditLogs       AuditLog[]
  calendarEvents  CalendarEvent[]
  officeWeeks     OfficeWeek[]
  vacations       Vacation[]
  ticketDrafts    TicketDraft[]
  privateTasks    PrivateTask[]
  departments     UserDepartment[]
  preferences     UserPreferences?
  permissions     UserPermissions?
}

model Invite {
  id        String    @id @default(cuid())
  email     String
  name      String?
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model PasswordReset {
  id        String    @id @default(cuid())
  email     String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Category {
  id   String @id @default(cuid())
  name String
  // Lowercased name, written by the application — same reason as Department:
  // a LOWER() expression index only folds accents on a UTF-8 aware collation.
  nameNormalized String
  // Categories are per-department: the work differs enough between departments
  // that a shared list is noise. Company-wide tickets therefore have no
  // category, since a department's category says nothing about them.
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  tickets      Ticket[]

  @@unique([departmentId, nameNormalized])
  @@index([departmentId])
}

model Ticket {
  id          String       @id @default(cuid())
  title       String
  description String
  status      TicketStatus @default(OPEN)
  priority    Priority     @default(MEDIUM)
  pinned      Boolean      @default(false)
  // Date-only in practice: written from an <input type="date"> as UTC midnight,
  // exactly like PrivateTask.dueDate, so the reminder cron can compare whole days.
  dueDate     DateTime?
  reminderDaysBefore Int?      // days before dueDate to send the email; null = no reminder
  reminderSentAt     DateTime? // set once sent, so the daily cron doesn't repeat it
  // Visibility scope. DEPARTMENT ⇒ departmentId set; COMPANY_WIDE ⇒ null.
  visibility   TicketVisibility @default(DEPARTMENT)
  departmentId String?
  // Restrict: a department that still has tickets must not be deletable. SET NULL
  // (Prisma's default for an optional relation) would leave visibility
  // 'DEPARTMENT' with a null departmentId and break the DB CHECK constraint.
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id])
  assigneeId  String?
  assignee    User?        @relation("AssignedTo", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?        @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  comments    Comment[]
  attachments Attachment[]
  activities  ActivityLog[]
  notifications NotificationLog[]
  privateTasks PrivateTask[]
  collaborators TicketCollaborator[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([visibility, departmentId])
  @@index([departmentId])
}

model Comment {
  id          String       @id @default(cuid())
  ticketId    String
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  body        String
  isInternal  Boolean      @default(false)
  attachments Attachment[]
  createdAt   DateTime     @default(now())
}

model Attachment {
  id           String   @id @default(cuid())
  ticketId     String?
  commentId    String?
  ticket       Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment      Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  fileUrl      String
  fileName     String
  fileSize     Int      @default(0)
  mimeType     String?
  uploadedById String
  createdAt    DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
}

model SavedReply {
  id          String   @id @default(cuid())
  title       String
  body        String
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model ChangelogEntry {
  id          String   @id @default(cuid())
  version     String
  title       String
  content     String   @db.Text
  authorId    String?
  authorName  String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model ShiftDay {
  id            String   @id @default(cuid())
  date          DateTime
  timeStart     String?
  timeEnd       String?
  location      String?
  shopName      String?
  address       String?
  contactEmail  String?
  contactPhone  String?
  assignedTo    String?
  forSelf       Boolean  @default(false)
  adMode        String?
  notes         String?
  shopCode      String?
  rowIndex      Int
  sheetTab      String   @default("2026")
  syncedAt      DateTime @default(now())
  strikethrough Boolean  @default(false)
  bgColor       String?

  @@unique([rowIndex, sheetTab])
}

model OfficeWeek {
  id             String   @id @default(cuid())
  weekStart      DateTime
  assignedUserId String?
  assignedUser   User?    @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  isManual       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([weekStart])
}

enum PrivateTaskColumn {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

/// A user's own task board. Only the owner may ever read these rows through the
/// API — see lib/private-tasks.ts. When linked to a ticket, the only thing that
/// leaks publicly is the newest updatedAt among the linked rows.
model PrivateTask {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?           @db.Text
  column      PrivateTaskColumn @default(TODO)
  priority    Priority          @default(MEDIUM)
  dueDate     DateTime?
  reminderDaysBefore Int?       // days before dueDate to send the email; null = no reminder
  reminderSentAt     DateTime?  // set once sent, so the daily cron doesn't repeat it
  position    Int               @default(0)
  ticketId    String?
  ticket      Ticket?           @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  comments    PrivateTaskComment[]
  events      PrivateTaskEvent[]
  doneAt      DateTime?         // when it most recently entered the Kész column — archive sort key
  archivedAt  DateTime?         // set once filed away; archived tasks leave the board
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, column])
  @@index([userId, archivedAt])
  @@index([ticketId])
}

/// Lifecycle history of a private task — creation, each column move, archiving.
/// Same owner-only visibility as the task (reached only through it). Comments
/// live in their own table and are merged in by timestamp for the history view.
model PrivateTaskEvent {
  id            String             @id @default(cuid())
  privateTaskId String
  privateTask   PrivateTask        @relation(fields: [privateTaskId], references: [id], onDelete: Cascade)
  type          String             // 'created' | 'moved' | 'archived'
  fromColumn    PrivateTaskColumn?
  toColumn      PrivateTaskColumn?
  createdAt     DateTime           @default(now())

  @@index([privateTaskId])
}

/// Progress notes on a private task. Readable only through the parent task, so
/// they inherit its owner-only rule. Writing one touches the parent's updatedAt
/// — that timestamp is what the public ticket surfaces as "last updated".
model PrivateTaskComment {
  id            String      @id @default(cuid())
  privateTaskId String
  privateTask   PrivateTask @relation(fields: [privateTaskId], references: [id], onDelete: Cascade)
  body          String      @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([privateTaskId])
}

model UserPreferences {
  id                        String  @id @default(cuid())
  userId                    String  @unique
  user                      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifyTickets             Boolean @default(true)
  notifyCalendarSzuronap    Boolean @default(true)
  notifyCalendarHetes       Boolean @default(true)
  notifyCalendarEgyeb       Boolean @default(true)
  excludeFromOfficeRotation Boolean @default(false)
  ticketFilters             String? @db.Text
}

model UserPermissions {
  id                          String  @id @default(cuid())
  userId                      String  @unique
  user                        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  canRegenerateOfficeSchedule Boolean @default(false)
  canManageEmailNotifications Boolean @default(false)
  canSendInvites              Boolean @default(false)
  canDeleteTickets            Boolean @default(false)
  canDeleteComments           Boolean @default(false)
  canManageCategories         Boolean @default(false)
  canCreateCompanyWideTasks   Boolean @default(false)
}

model TicketDraft {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String   @default("")
  description String   @default("") @db.Text
  priority    String   @default("MEDIUM")
  categoryId  String?
  assigneeId  String?
  // Kept on the draft as well, so a deadline typed into the new-ticket form
  // isn't silently lost when the draft is reloaded.
  dueDate     String?  // yyyy-mm-dd, exactly as the date input holds it
  reminderDaysBefore Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vacation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  note      String?
  createdAt DateTime @default(now())
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  type        String   @default("EGYEB")
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
}

/**
 * Extra colleagues working on a public ticket. The ticket keeps exactly one
 * assignee — this is "who else is on it", not a second owner.
 *
 * Being a collaborator *grants access* to the ticket (see ticketAccessWhere),
 * which is the point: help can be pulled in from another department. That makes
 * adding someone a deliberate act, so who may do it is restricted in
 * lib/ticket-collaborators.ts rather than per route.
 */
model TicketCollaborator {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("TicketCollaborator", fields: [userId], references: [id], onDelete: Cascade)
  // Who pulled them in; null once that account is deleted, and null for a
  // self-join, which is how the two cases are told apart afterwards.
  addedById String?
  addedBy   User?    @relation("TicketCollaboratorAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([ticketId, userId])
  @@index([userId])
}

model NotificationLog {
  id       String   @id @default(cuid())
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type     String
  message  String?
  link     String?
  read     Boolean  @default(false)
  sentAt   DateTime @default(now())
}
